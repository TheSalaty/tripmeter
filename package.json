{
  "name": "tripmeter",
  "version": "1.3.0",
  "description": "GNOME Shell extension showing Claude Code and Codex usage limits, resets and API-equivalent cost",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "tsc -p tsconfig.tests.json && node --test build/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "install-extension": "make install",
    "pack": "make pack"
  },
  "devDependencies": {
    "@girs/gnome-shell": "^50.0.4",
    "@girs/soup-3.0": "^4.1.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.0.0"
  }
}
