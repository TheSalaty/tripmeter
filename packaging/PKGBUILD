# Maintainer: TheSalaty <j.ullrich@creedle.io>
_uuid=tripmeter@thesalaty.github.io
pkgname=tripmeter
pkgver=1.3.0
pkgrel=1
pkgdesc="Tripmeter Usage: AI usage tracker and Verbrauch monitor for Claude Code and OpenAI Codex — Claude/Codex usage and limits, token use, 5-hour/weekly quotas, resets and API cost"
arch=('any')
url="https://github.com/TheSalaty/tripmeter"
license=('MIT')
depends=('gnome-shell>=1:49')
makedepends=('npm' 'glib2-devel')
install=tripmeter.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
        'tripmeter-remind-enable'
        'tripmeter-remind-enable.desktop')
sha256sums=('7716148b777a507ccc9a073afb9f8ac3c7c677fadaf4653c93d7d5c80aebac02'
            '5cc0e150ce5d4caaea997337540bb57ce6b7965cf69a8611b5ff8f3fbcd78a10'
            'adec82ff284b8f1e5dd047fd39d150676e0c7e55146b37259d7c2d6368994ed3')

_srcdir="tripmeter-$pkgver"

prepare() {
  cd "$_srcdir"
  # The build needs the TypeScript compiler and the GJS type packages; none of it ships.
  npm ci --cache "$srcdir/npm-cache"
}

build() {
  cd "$_srcdir"
  make schemas assets
}

check() {
  cd "$_srcdir"
  make test
}

package() {
  cd "$_srcdir"
  install -d "$pkgdir/usr/share/gnome-shell/extensions/$_uuid"
  cp -r build/src/. "$pkgdir/usr/share/gnome-shell/extensions/$_uuid/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm755 "$srcdir/tripmeter-remind-enable" "$pkgdir/usr/lib/tripmeter/remind-enable"
  install -Dm644 "$srcdir/tripmeter-remind-enable.desktop" "$pkgdir/etc/xdg/autostart/tripmeter-remind-enable.desktop"
}
